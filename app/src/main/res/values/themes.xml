    <style name="Theme.GpsMap.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.GpsMap.BottomSheet</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Widget.GpsMap.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">?attr/colorSurface</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.GpsMap.Sheet</item>
    </style>

    <style name="ShapeAppearance.GpsMap.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="TextAppearance.GpsMap.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">8sp</item>
        <item name="android:textColor">?attr/hudSubtleColor</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.GpsMap.Value" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/hudTextColor</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.GpsMap.HudRecordButton" parent="Widget.Material3.Button">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">5dp</item>
        <item name="iconGravity">textStart</item>
        <item name="cornerRadius">20dp</item>
    </style>

    <style name="Widget.GpsMap.ModeButton" parent="Widget.Material3.Button">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="iconSize">16dp</item>
        <item name="iconPadding">6dp</item>
        <item name="iconGravity">textStart</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
