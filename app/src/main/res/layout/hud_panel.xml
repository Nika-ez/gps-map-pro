<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- The expanded page is pixel-matched to the original 250dp panel. -->
    <RelativeLayout
        android:id="@+id/expandedLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvExpPlaceholderKmh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="km/h: (none)"
            android:textColor="#00000000"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvExpPlaceholderTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:maxLines="1"
            android:text="--:--"
            android:textColor="#00000000"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvExpPlaceholderBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvExpPlaceholderTime"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="8dp"
            android:maxLines="1"
            android:text="Bat: --%"
            android:textColor="#00000000"
            android:textSize="16sp" />

        <com.nika.gpsmap.ui.CompassView
            android:id="@+id/compass"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_below="@id/tvExpPlaceholderKmh"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvGpsAcc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/compass"
            android:layout_marginTop="12dp"
            android:maxLines="1"
            android:text="GPS Acc: --"
            android:textColor="#AAAAAA"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/extraStats"
            android:layout_width="168dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvExpPlaceholderBattery"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAltitude"
                        style="@style/TextAppearance.GpsMap.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="&#8212;" />

                    <TextView
                        style="@style/TextAppearance.GpsMap.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/altitude" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvHeading"
                        style="@style/TextAppearance.GpsMap.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="&#8212;" />

                    <TextView
                        style="@style/TextAppearance.GpsMap.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/heading" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvFix"
                        style="@style/TextAppearance.GpsMap.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="&#8212;" />

                    <TextView
                        style="@style/TextAppearance.GpsMap.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fix" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTripDistance"
                        style="@style/TextAppearance.GpsMap.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="0.00" />

                    <TextView
                        style="@style/TextAppearance.GpsMap.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/distance" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTripAvg"
                        style="@style/TextAppearance.GpsMap.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="0.0" />

                    <TextView
                        style="@style/TextAppearance.GpsMap.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/avg_speed" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTripMax"
                        style="@style/TextAppearance.GpsMap.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="0.0" />

                    <TextView
                        style="@style/TextAppearance.GpsMap.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/max_speed" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvCoords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="&#8212;"
                android:textColor="?attr/hudExtraColor"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSatellites"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="30dp"
            android:maxLines="1"
            android:text="Sats: 0"
            android:textColor="#0A84FF"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/actionRow"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/app_settings"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings"
                app:tint="?attr/hudTextColor" />

            <ImageButton
                android:id="@+id/btnResetTrip"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/reset_trip"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_reset"
                app:tint="?attr/hudTextColor" />

            <ImageButton
                android:id="@+id/btnRecord"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/record"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_record"
                app:tint="?attr/hudAccentColor" />

            <ImageButton
                android:id="@+id/btnTracks"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/tracks"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_folder"
                app:tint="?attr/hudTextColor" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Exactly the original mini bar: 100dp tall, 30dp above the panel bottom. -->
    <RelativeLayout
        android:id="@+id/miniLayout"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="30dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingHorizontal="24dp">

        <TextView
            android:id="@+id/tvSharedTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:maxLines="1"
            android:text="--:--"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSharedKmh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:maxLines="1"
            android:text="km/h: (none)"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSharedBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:maxLines="1"
            android:text="--%"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
    </RelativeLayout>

    <!-- 60x6 bar, exactly where the original handle sat (12dp from the bottom). -->
    <FrameLayout
        android:id="@+id/dragHandleArea"
        android:layout_width="88dp"
        android:layout_height="30dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:contentDescription="@string/expand_dashboard">

        <View
            android:id="@+id/dragBar"
            android:layout_width="60dp"
            android:layout_height="6dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_drag_handle"
            android:backgroundTint="?attr/hudHandleColor" />
    </FrameLayout>
</merge>
